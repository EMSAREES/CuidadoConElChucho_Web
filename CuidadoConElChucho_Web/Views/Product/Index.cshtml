@model List<ProductVM>

<div class="cch-page-header">
    <div>
        <h1>Productos</h1>
        <div class="cch-subtitle">Catálogo de ropa de Cuidado con el Chucho</div>
    </div>
    <div class="d-flex align-items-center gap-3 flex-wrap">
        <div class="cch-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="cchSearch" class="form-control" placeholder="Buscar producto..." />
        </div>
        <a href="/Product/AddEdit" class="btn btn-cch-primary">
            <i class="fa-solid fa-plus"></i> Nuevo producto
        </a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="cch-empty cch-table-card">
        <i class="fa-solid fa-shirt"></i>
        <p class="mb-0">Aún no hay productos registrados.</p>
    </div>
}
else
{
    <div class="cch-product-grid">
        @foreach (var product in Model)
        {
            <div class="cch-product-card" data-search-item="@product.Name @product.CategoryName">
                <div class="cch-product-media">
                    @if (!string.IsNullOrEmpty(product.ImageName))
                    {
                        <img src="~/images/products/@product.ImageName" alt="@product.Name" />
                    }
                    else
                    {
                        <div class="cch-no-image"><i class="fa-solid fa-image"></i></div>
                    }

                    @if (!string.IsNullOrEmpty(product.CategoryName))
                    {
                        <span class="cch-product-category">@product.CategoryName</span>
                    }

                    <span class="cch-product-status @(product.IsActive ? "cch-status-active" : "cch-status-inactive")">
                        @(product.IsActive ? "Activo" : "Inactivo")
                    </span>
                </div>

                <div class="cch-product-body">
                    <div class="cch-product-name">@product.Name</div>
                    <div class="cch-product-gender">@product.Gender.GetDisplayName()</div>

                    <div class="cch-product-swatches">
                        @foreach (var hex in product.ColorSwatches.Take(5))
                        {
                            <span class="cch-swatch" style="background:@hex"></span>
                        }
                        @if (product.ColorSwatches.Count > 5)
                        {
                            <span class="cch-swatch-more">+@(product.ColorSwatches.Count - 5)</span>
                        }
                    </div>

                    <div class="cch-product-price">$@product.Price.ToString("N2")</div>

                    <div class="cch-product-stock @(product.TotalStock == 0 ? "text-danger" : "")">
                        <i class="fa-solid fa-box"></i> @(product.TotalStock == 0 ? "Sin stock" : $"{product.TotalStock} en stock")
                    </div>

                    <div class="cch-product-actions">
                        <a href="/Product/AddEdit/@product.ProductId" class="btn-cch-icon btn-cch-edit">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                        <button type="button" class="btn-cch-icon btn-cch-delete"
                                onclick="cchConfirmDelete('@Url.Action("Delete", "Product")?id=@product.ProductId', '@product.Name')">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}