@model List<CategoryVM>

<div class="row justify-content-around mt-4">
    <div class="Col-4">
        <h4>Categoria</h4>
    </div>

    <div class="col-4 text-end">
        <a href="#" class="btn btn-success"><i class="fa-solid fa-plus"></i> Crear</a>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th style="width:120px">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td style="width:120px">
                    <a href="#" class="btn btn-sm btn-primary"><i class="fa-solid fa-pen"></i></a>
                    <a class="btn btn-sm btn-danger"><i class="fa-solid fa-trash"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>