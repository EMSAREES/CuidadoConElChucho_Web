@model List<CategoryVM>

<div class="cch-page-header">
    <div>
        <h1>Categorías</h1>
        <div class="cch-subtitle">Organiza los tipos de prendas de la tienda</div>
    </div>
    <div class="d-flex align-items-center gap-3 flex-wrap">
        <div class="cch-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="cchSearch" class="form-control" placeholder="Buscar categoría..." />
        </div>
        <a href="/Category/AddEdit" class="btn btn-cch-primary">
            <i class="fa-solid fa-plus"></i> Nueva categoría
        </a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="cch-empty cch-table-card">
        <i class="fa-solid fa-tags"></i>
        <p class="mb-0">Aún no hay categorías registradas.</p>
    </div>
}
else
{
    <div class="cch-table-card">
        <table class="table cch-table mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Productos</th>
                    <th style="width:140px">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr data-search-item="@category.Name">
                        <td class="fw-semibold">@category.Name</td>
                        <td><span class="cch-badge-count">0</span></td>
                        <td>
                            <div class="d-flex gap-2">
                                <a href="/Category/AddEdit/@category.CategoryId" class="btn-cch-icon btn-cch-edit" title="Editar">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <button type="button" class="btn-cch-icon btn-cch-delete" title="Eliminar"
                                        onclick="cchConfirmDelete('@Url.Action("Delete", "Category")?id=@category.CategoryId', '@category.Name')">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}